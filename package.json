{
  "name": "bull-city-blocks",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "play": "node --disable-warning=ExperimentalWarning --import ./scripts/ts-register.mjs apps/server/src/main.ts",
    "sim": "node --disable-warning=ExperimentalWarning --import ./scripts/ts-register.mjs packages/sim/bin/sim.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "fast-check": "4.11.0",
    "typescript": "7.0.2",
    "vitest": "5.1.2"
  }
}
